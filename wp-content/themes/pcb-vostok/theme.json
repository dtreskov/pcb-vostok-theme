{
    "$schema": "https://schemas.wp.org/wp/6.8/theme.json",
    "version": 3,

    "settings": {
        "appearanceTools": true,

        "layout": {
            "contentSize": "1290px",
            "wideSize": "90vw"
        },

        "color": {
            "defaultPalette": false,
            "defaultGradients": false,
            "custom": true,
            "palette": [
                {
                    "slug": "primary",
                    "name": "Primary",
                    "color": "#14543E"
                },
                {
                    "slug": "primary-dark",
                    "name": "Primary Dark",
                    "color": "#0B2C22"
                },
                {
                    "slug": "primary-light",
                    "name": "Primary Light",
                    "color": "#E4EFE9"
                },
                {
                    "slug": "copper",
                    "name": "Copper",
                    "color": "#C0703A"
                },
                {
                    "slug": "copper-dark",
                    "name": "Copper Dark",
                    "color": "#A85C28"
                },
                {
                    "slug": "copper-light",
                    "name": "Copper Light",
                    "color": "#F7EDE4"
                },
                {
                    "slug": "gold",
                    "name": "Gold",
                    "color": "#D8B45A"
                },
                {
                    "slug": "gold-light",
                    "name": "Gold Light",
                    "color": "#FBF3DF"
                },
                {
                    "slug": "page-background",
                    "name": "Page Background",
                    "color": "#FAFBFA"
                },
                {
                    "slug": "section-alt",
                    "name": "Section Alt",
                    "color": "#F1F4F2"
                },
                {
                    "slug": "separator",
                    "name": "Separator",
                    "color": "#E2E8E4"
                },
                {
                    "slug": "grey",
                    "name": "Grey",
                    "color": "#5C6B64"
                },
                {
                    "slug": "black",
                    "name": "Black",
                    "color": "#16211C"
                },
                {
                    "slug": "white",
                    "name": "White",
                    "color": "#FFFFFF"
                }
            ]
        },

        "spacing": {
            "customSpacingSize": true,
            "units": ["px", "em", "rem", "vh", "vw", "%"],
            "spacingSizes": [
                {
                    "slug": "xs",
                    "name": "XS",
                    "size": "4px"
                },
                {
                    "slug": "sm",
                    "name": "SM",
                    "size": "8px"
                },
                {
                    "slug": "md",
                    "name": "MD",
                    "size": "16px"
                },
                {
                    "slug": "lg",
                    "name": "LG",
                    "size": "24px"
                },
                {
                    "slug": "xl",
                    "name": "XL",
                    "size": "32px"
                },
                {
                    "slug": "xxl",
                    "name": "XXL",
                    "size": "48px"
                }
            ]
        },

        "typography": {
            "fluid": true,
            "fontFamilies": [
                {
                    "slug": "inter",
                    "name": "Inter",
                    "fontFamily": "\"Inter\", system-ui, -apple-system, \"Segoe UI\", Roboto, Arial, sans-serif"
                }
            ],
            "fontSizes": [
                {
                    "slug": "small",
                    "name": "Small",
                    "size": "14px"
                },
                {
                    "slug": "medium",
                    "name": "Medium",
                    "size": "16px"
                },
                {
                    "slug": "lead",
                    "name": "Lead",
                    "size": "18px"
                },
                {
                    "slug": "large",
                    "name": "Large",
                    "size": "clamp(24px, 3vw, 36px)"
                },
                {
                    "slug": "x-large",
                    "name": "X-Large",
                    "size": "clamp(34px, 4.5vw, 56px)"
                }
            ]
        }
    },

    "styles": {
        "layout": {
            "contentSize": "1290px",
            "wideSize": "90vw"
        }
    }
}
